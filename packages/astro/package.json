{
	"name": "@footprint/astro",
	"version": "0.0.0",
	"description": "Astro integration for footprint: the browser SDK on every page, and server middleware",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./middleware": {
			"types": "./dist/middleware.d.ts",
			"import": "./dist/middleware.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
	},
	"peerDependencies": {
		"@footprint/browser": "*",
		"@footprint/node": "*"
	},
	"peerDependenciesMeta": {
		"@footprint/node": {
			"optional": true
		}
	},
	"devDependencies": {
		"@footprint/browser": "workspace:*",
		"@footprint/node": "workspace:*",
		"@types/node": "22.20.3",
		"happy-dom": "20.14.5",
		"tsdown": "0.23.0",
		"typescript": "^6.0.3",
		"vitest": "4.1.11"
	}
}
