{
	"name": "@tracemark/vue",
	"version": "0.0.0",
	"description": "Vue 3 plugin and composables for tracemark: flags and error capture",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
	},
	"peerDependencies": {
		"@tracemark/browser": "*",
		"vue": "^3.3.0"
	},
	"devDependencies": {
		"@tracemark/browser": "workspace:*",
		"@types/node": "22.20.3",
		"happy-dom": "20.14.5",
		"tsdown": "0.23.0",
		"typescript": "^6.0.3",
		"vitest": "4.1.11",
		"vue": "3.5.44"
	}
}
