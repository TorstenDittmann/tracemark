{
	"name": "@footprint/node",
	"version": "0.0.0",
	"description": "Node.js SDK for footprint, self-hosted product analytics",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
	},
	"devDependencies": {
		"@footprint/flags": "workspace:*",
		"@types/node": "22.20.3",
		"tsdown": "0.23.0",
		"typescript": "^6.0.3",
		"vitest": "4.1.11"
	}
}
