{
	"name": "@footprint/svelte",
	"version": "0.0.0",
	"description": "Svelte stores for footprint feature flags",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
	},
	"peerDependencies": {
		"@footprint/browser": "*",
		"svelte": "^4.0.0 || ^5.0.0"
	},
	"devDependencies": {
		"@footprint/browser": "workspace:*",
		"@types/node": "22.20.3",
		"happy-dom": "20.14.5",
		"svelte": "^5.57.2",
		"tsdown": "0.23.0",
		"typescript": "^6.0.3",
		"vitest": "4.1.11"
	}
}
