# Shared secret between the ingest service and the app. Generate one with: openssl rand -hex 32
INTERNAL_TOKEN=
# Signs session cookies. Generate one with: openssl rand -hex 32
AUTH_SECRET=
# Public hostname, e.g. analytics.example.com (Caddy then fetches a TLS certificate). Default: plain HTTP.
TRACEMARK_HOST=:80
TRACEMARK_PORT=8080
# The URL people open in the browser. Must match TRACEMARK_HOST, e.g. https://analytics.example.com
PUBLIC_URL=http://localhost:8080
CLICKHOUSE_PASSWORD=tracemark
# docker-compose.prod.yml only: image version to run, e.g. 0.1.0. Default: latest
TRACEMARK_VERSION=
# Optional: path inside the ingest container to a MaxMind-format city database in ./geoip, e.g. /geoip/dbip-city-lite.mmdb
GEOIP_DB=
