{
	"name": "@tracemark/app",
	"private": true,
	"version": "0.0.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun run --bun vite build",
		"start": "bun ./build",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"db:generate": "drizzle-kit generate",
		"migrate": "bun ./scripts/migrate.ts",
		"create-project": "bun ./scripts/create-project.ts",
		"reset-password": "bun ./scripts/reset-password.ts"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"better-auth": "^1.7.7",
		"drizzle-orm": "^0.45.3"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@tracemark/flags": "workspace:*",
		"@internationalized/date": "^3.12.4",
		"@jridgewell/trace-mapping": "0.3.31",
		"@lucide/svelte": "^1.52.0",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
