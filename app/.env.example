# libSQL database (embedded file by default; use libsql://… for sqld/Turso)
DATABASE_URL=file:./data/tracemark.db
# ClickHouse HTTP endpoint
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=tracemark
# Shared secret the ingest service uses to read project keys
INTERNAL_TOKEN=change-me
