# One public hostname: event ingestion goes to the Rust service, everything else to the app.
{$FOOTPRINT_HOST::80} {
	# Add /v1/traces here once ingest accepts OTLP (AI observability phase).
	@ingest path /e /e/*
	handle @ingest {
		reverse_proxy ingest:8081
	}
	handle {
		reverse_proxy app:3000
	}
}
